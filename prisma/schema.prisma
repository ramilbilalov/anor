// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Singleton row (id = "singleton") with restaurant info shown on the site.
model Settings {
  id             String   @id @default("singleton")
  restaurantName String   @default("Анор")
  description    String   @default("")
  address        String   @default("")
  phone          String   @default("")
  workingHours   String   @default("")
  deliveryInfo   String   @default("")
  updatedAt      DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String      @default("")
  composition String      @default("")
  price       Int
  imageUrl    String?
  isAvailable Boolean     @default(true)
  sortOrder   Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Order status values (SQLite has no native enum): NEW, CONFIRMED, PREPARING, DELIVERING, DONE, CANCELLED
model Order {
  id            String      @id @default(cuid())
  customerName  String
  phone         String
  address       String
  comment       String      @default("")
  status        String      @default("NEW")
  totalPrice    Int
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Int
  quantity  Int
}
